# ─────────────────────────────────────────────────────
#  Kay's Haven Backend — Environment Variables
#  Copy this file to .env and fill in the real values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────

# Server
PORT=3000

# Paystack — get these from https://dashboard.paystack.com/#/settings/developer
# Use test keys (sk_test_... / pk_test_...) for development
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP — for contact-form email delivery
# Gmail example: enable "App Passwords" under your Google account settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email address that receives contact form submissions
CONTACT_EMAIL=Kayshaven.gh@gmail.com

# Frontend origin (used for CORS — update for production domain)
FRONTEND_URL=http://127.0.0.1:5500
